<UserControl x:Class="Toolbox.Sidebar.SidebarView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="10,8,8,6">
            <TextBox x:Name="Filter" AutomationProperties.AutomationId="SidebarFilter"
                     AutomationProperties.Name="Filter" TextChanged="OnFilterChanged" />
            <TextBlock x:Name="FilterHint" Text="Filter" IsHitTestVisible="False" Margin="11,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <Button DockPanel.Dock="Bottom" x:Name="AddButton" Style="{StaticResource ToolButton}" Width="NaN"
                HorizontalAlignment="Left" Margin="10,4,8,8" Click="OnAddClicked"
                ToolTip="New connection, credential, folder or provider"
                AutomationProperties.AutomationId="SidebarAdd" AutomationProperties.Name="New">
            <StackPanel Orientation="Horizontal" Margin="8,0,10,0">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text="New" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Padding="2,0,0,0"
                  AutomationProperties.AutomationId="SidebarTree" AutomationProperties.Name="Connections"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove"
                  PreviewMouseLeftButtonUp="OnTreeMouseUp" PreviewMouseRightButtonDown="OnTreeRightDown"
                  MouseRightButtonUp="OnTreeRightUp" PreviewMouseDoubleClick="OnTreeDoubleClick"
                  PreviewKeyDown="OnTreeKeyDown" SelectedItemChanged="OnSelectionChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding KindLabel}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Border x:Name="Row" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                            CornerRadius="4" Padding="0,2,4,2" MinHeight="26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="20" Margin="0,0,7,0" VerticalAlignment="Center"
                                  Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock x:Name="Icon" Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <!-- A provider is a folder with a gear on it. -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="5"
                                        Width="11" Height="11" Margin="0,0,-2,-2"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        Visibility="{Binding IsProvider, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <!-- Shown on folders that pass a credential down. -->
                            <TextBlock Grid.Column="2" Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" Margin="6,0,2,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       ToolTip="{Binding BadgeTip}" AutomationProperties.Name="Has a credential"
                                       Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="Spinner" Grid.Column="3" Text="&#xE895;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Margin="6,0,2,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       AutomationProperties.Name="Syncing"
                                       Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsTinted}" Value="True">
                            <Setter TargetName="Icon" Property="Foreground"
                                    Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                            <Setter TargetName="TitleText" Property="FontSize" Value="11" />
                            <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="TitleText" Property="Foreground"
                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Row" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Spin">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Spinner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
