<Project>
  <PropertyGroup>
    <!-- The marketing version lives in the VERSION file at the repo root.
         tools\build.ps1 passes the build number (the commit count). -->
    <ToolboxVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</ToolboxVersion>
    <ToolboxBuild Condition="'$(ToolboxBuild)' == ''">0</ToolboxBuild>
    <Version>$(ToolboxVersion)</Version>
    <FileVersion>$(ToolboxVersion).$(ToolboxBuild)</FileVersion>
    <InformationalVersion>$(ToolboxVersion) (build $(ToolboxBuild))</InformationalVersion>
    <Company>Toolbox</Company>
    <Product>Toolbox</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- The compiler writes where it was run into an assembly (the path of
         its debug file, at least). This checkout's folder is under the
         profile folder, which is the account name, and builds are handed
         to other people: it is written as "toolbox" instead. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=toolbox</PathMap>
    <!-- Keep the commit hash out of the product version string. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
