<?xml version="1.0" encoding="utf-8"?>
<!-- The build restores from nuget.org only, whatever the machine's own
     NuGet configuration holds (the dev machine's is empty). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
